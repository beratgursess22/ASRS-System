<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ASRS ERP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

        bool IsActive(string ctrl, string? action = null) =>
            string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) &&
            (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));

        var userInitial = User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?";
        var userEmail = User.Identity?.Name ?? "";
        var userRole = User.Claims
                             .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                             .Select(c => c.Value)
                             .FirstOrDefault() ?? "Kullanıcı";

        var isPurchaseActive = IsActive("PurchaseRequest") || IsActive("PurchaseOrder") || IsActive("Supplier");
        var isProductionActive = IsActive("Uretim") || IsActive("WorkOrder");
        var isWarehouseActive = IsActive("Depo") || IsActive("Product") || IsActive("Material");
    }

    <!-- Sidebar -->
    <nav class="sidebar">
        <a class="sidebar-logo" asp-controller="Dashboard" asp-action="Index">
            <div class="sidebar-logo-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="7" height="7" />
                    <rect x="15" y="3" width="7" height="7" />
                    <rect x="2" y="14" width="7" height="7" />
                    <rect x="15" y="14" width="7" height="7" />
                </svg>
            </div>
            <div class="sidebar-logo-text">
                <strong>ASRS ERP</strong>
                <span>Depo Yönetim Sistemi</span>
            </div>
        </a>

        <div class="sidebar-nav">
            <div class="sidebar-section">Ana Menü</div>

            <a class="nav-item @(IsActive("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" />
                    <rect x="14" y="3" width="7" height="7" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                </svg>
                <span>Dashboard</span>
            </a>

            <a class="nav-item @(IsActive("Hareket") ? "active" : "")" asp-controller="Hareket" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="17 1 21 5 17 9" />
                    <path d="M3 11V9a4 4 0 0 1 4-4h14" />
                    <polyline points="7 23 3 19 7 15" />
                    <path d="M21 13v2a4 4 0 0 1-4 4H3" />
                </svg>
                <span>Hareketler</span>
            </a>

            <div class="sidebar-section">Yönetim</div>

            <a class="nav-item @(IsActive("User") ? "active" : "")" asp-controller="User" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                <span>Kullanıcılar</span>
            </a>

            <a class="nav-item @(IsActive("Rapor") ? "active" : "")" asp-controller="Rapor" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="20" x2="18" y2="10" />
                    <line x1="12" y1="20" x2="12" y2="4" />
                    <line x1="6" y1="20" x2="6" y2="14" />
                </svg>
                <span>Raporlar</span>
            </a>

            <a class="nav-item @(IsActive("Ayar") ? "active" : "")" asp-controller="Ayar" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path
                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
                <span>Ayarlar</span>
            </a>

            <div class="sidebar-section">Departmanlar</div>

            <a class="nav-item @(IsActive("Kalite") ? "active" : "")" asp-controller="Kalite" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                <span>Kalite</span>
            </a>

            <details class="nav-group @(isProductionActive ? "active" : "")" @(isProductionActive ? "open" : null)>
                <summary class="nav-item nav-group-trigger">
                    <span class="nav-group-main">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
                            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
                        </svg>
                        <span>Üretim</span>
                    </span>
                    <svg class="nav-group-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </summary>

                <div class="nav-group-items">
                    <a class="nav-item nav-sub-item @(IsActive("WorkOrder") ? "active" : "")" asp-controller="WorkOrder" asp-action="Index">
                        <span>İş Emirleri</span>
                    </a>
                </div>
            </details>

            <a class="nav-item @(IsActive("Lojistik") ? "active" : "")" asp-controller="Lojistik" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13" rx="1" />
                    <path d="M16 8h4l3 3v5h-7V8z" />
                    <circle cx="5.5" cy="18.5" r="2.5" />
                    <circle cx="18.5" cy="18.5" r="2.5" />
                </svg>
                <span>Lojistik</span>
            </a>

            <details class="nav-group @(isWarehouseActive ? "active" : "")" @(isWarehouseActive ? "open" : null)>
                <summary class="nav-item nav-group-trigger">
                    <span class="nav-group-main">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                            <polyline points="9 22 9 12 15 12 15 22" />
                        </svg>
                        <span>Depo</span>
                    </span>
                    <svg class="nav-group-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                </summary>

                <div class="nav-group-items">
                    <a class="nav-item nav-sub-item @(IsActive("Product") ? "active" : "")" asp-controller="Product" asp-action="Index">
                        <span>Ürünler</span>
                    </a>

                    <a class="nav-item nav-sub-item @(IsActive("Material") ? "active" : "")" asp-controller="Material" asp-action="Index">
                        <span>Malzemeler</span>
                    </a>
                </div>
            </details>

            @if (User.IsInRole("Yönetici") || User.IsInRole("Satın Alma"))
            {
                <details class="nav-group @(isPurchaseActive ? "active" : "")" @(isPurchaseActive ? "open" : null)>
                    <summary class="nav-item nav-group-trigger">
                        <span class="nav-group-main">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 7h18" />
                                <path d="M5 7v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7" />
                                <path d="M8 11h8" />
                                <path d="M8 15h5" />
                            </svg>
                            <span>Satin Alma</span>
                        </span>
                        <svg class="nav-group-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9" />
                        </svg>
                    </summary>

                    <div class="nav-group-items">
                        <a class="nav-item nav-sub-item @(IsActive("PurchaseRequest") ? "active" : "")" asp-controller="PurchaseRequest" asp-action="Index">
                            <span>Satin Alma Talep</span>
                        </a>

                        <a class="nav-item nav-sub-item @(IsActive("PurchaseOrder") ? "active" : "")" asp-controller="PurchaseOrder" asp-action="Index">
                            <span>Satin Alma Siparis</span>
                        </a>

                        <a class="nav-item nav-sub-item @(IsActive("Supplier") ? "active" : "")" asp-controller="Supplier" asp-action="Index">
                            <span>Tedarikciler</span>
                        </a>
                    </div>
                </details>
            }
        </div>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="sidebar-user-avatar">@userInitial</div>
                <div>
                    <div class="sidebar-user-name">@userEmail</div>
                    <div class="sidebar-user-role">@userRole</div>
                </div>
            </div>
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <polyline points="16 17 21 12 16 7" />
                        <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    Çıkış Yap
                </button>
            </form>
        </div>
    </nav>

    <!-- Main -->
    <div class="main-wrap">
        <div class="topbar">
            <span class="topbar-title">@(ViewData["Title"] ?? "ASRS ERP")</span>
            <div class="topbar-right">
                <span class="topbar-badge">v1.0</span>
            </div>
        </div>
        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

    <script>
        (function () {
            const DISPLAY_MS = 2000;
            const container = document.getElementById("toastContainer");
            if (!container)
                return;

            function showToast(message, type, durationMs) {
                if (!message)
                    return;

                const toast = document.createElement("div");
                toast.className = `toast-card ${type === "error" ? "toast-error" : "toast-success"}`;
                toast.textContent = message;
                container.appendChild(toast);

                const timeout = Number.isFinite(durationMs) && durationMs > 0 ? durationMs : DISPLAY_MS;

                setTimeout(() => {
                    toast.classList.add("toast-hide");
                    setTimeout(() => toast.remove(), 220);
                }, timeout);
            }

            window.asrsShowToast = showToast;

            document.querySelectorAll(".page-content .alert-box:not([data-toast-ignore='true'])").forEach((el) => {
                const msg = (el.textContent || "").trim();
                const isError = el.classList.contains("alert-error");
                showToast(msg, isError ? "error" : "success");
                el.remove();
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>