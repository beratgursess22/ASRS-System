@model ASRS.Core.DTOs.MaterialListDto
@{
    ViewData["Title"] = "Malzeme Düzenle";
    var defaultCurrency = string.IsNullOrWhiteSpace(Model.DefaultCurrency) ? "TRY" : Model.DefaultCurrency;
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="page-header">
    <h1 class="page-title">Malzeme Düzenle</h1>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert-box alert-error">@ViewBag.Error</div>
}

<div class="card">
    <div class="card-header">
        <h2 class="card-title">@Model.Name</h2>
    </div>
    <form method="post" asp-action="Edit" asp-route-id="@Model.Id">
        <div class="form-row">
            <div class="form-group">
                <label>Malzeme Kodu</label>
                <input type="text" name="Code" class="form-input" value="@Model.Code" required />
            </div>
            <div class="form-group">
                <label>Malzeme Adı</label>
                <input type="text" name="Name" class="form-input" value="@Model.Name" required />
            </div>
            <div class="form-group">
                <label>Birim</label>
                <input type="text" name="Unit" class="form-input" value="@Model.Unit" required />
            </div>
            <div class="form-group">
                <label>Stok Miktarı</label>
                <input type="number" name="StockQuantity" class="form-input" value="@Model.StockQuantity" min="0" />
            </div>
            <div class="form-group">
                <label>Min. Stok Seviyesi</label>
                <input type="number" name="MinStockLevel" class="form-input" value="@Model.MinStockLevel" min="0" />
            </div>
            <div class="form-group">
                <label>Varsayilan Birim Fiyat</label>
                <input type="number" name="DefaultUnitPrice" class="form-input" value="@Model.DefaultUnitPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" />
            </div>
            <div class="form-group">
                <label>Varsayilan Para Birimi</label>
                <input type="text" name="DefaultCurrency" class="form-input" value="@defaultCurrency" maxlength="10" />
            </div>
            <div class="form-group">
                <label>Açıklama</label>
                <input type="text" name="Description" class="form-input" value="@Model.Description" />
            </div>
        </div>
        <div style="display:flex; gap:1rem; margin-top:1rem;">
            <button type="submit" class="btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn-edit">← Listeye Dön</a>
        </div>
    </form>
</div>
