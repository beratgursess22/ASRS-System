@{
    ViewData["Title"] = "Erişim Engellendi";
    Layout = null;
} 
@* // bu sayfa, kullanıcı gerekli yetkiye sahip olmadığında gösterilen özel bir hata sayfasıdır, layout kullanılmaz ve özel bir tasarıma sahiptir *@
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ASRS — Erişim Engellendi</title>
    <link rel="stylesheet" href="~/css/access-denied.css" />
</head>

<body>
<div class="grid-overlay"></div>
<div class="access-card">
    <div class="top-accent"></div>
    <div class="card-body">
        <div class="logo">
            <div class="logo-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
                          stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <div class="logo-name">
                <strong>ASRS</strong>
                <span>Enterprise Platform</span>
            </div>
        </div>
        <div class="divider"></div>
        <div class="error-code">403</div>
        <div class="lock-icon">
            <div class="lock-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <rect x="3" y="11" width="18" height="11" rx="2"
                          stroke="rgba(220,235,245,0.85)" stroke-width="1.6"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"
                          stroke="rgba(220,235,245,0.85)" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
            </div>
        </div>
        <h1 class="error-title">Erişim Engellendi</h1>
        <p class="error-desc">
            Bu sayfayı görüntülemek için gerekli yetkiye sahip değilsiniz.
            Farklı bir hesapla giriş yapın veya yöneticinizle iletişime geçin.
        </p>
        <div class="divider-mid"></div>
        <a asp-controller="Account" asp-action="Login" class="btn-back">Giriş Sayfasına Dön</a>
    </div>
    <p class="card-footer">© 2026 ASRS Enterprise Platform. Asude Hazal Peker ve İbrahim Berat Gürses tarafından geliştirilmektedir.Tüm hakları saklıdır.</p>
</div>
</body>
</html>