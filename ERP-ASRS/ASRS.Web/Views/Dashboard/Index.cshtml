@{
    ViewData["Title"] = "AS/RS Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="db-section-label">AS/RS Kontrol Paneli</div>

<div class="asrs-status-row">
    <div class="asrs-status-pill"><span class="dot-green"></span>ASRS: Hazır</div>
    <div class="asrs-status-pill"><span class="dot-yellow"></span>Komut Kuyruğu: İzleniyor</div>
    <div class="asrs-status-pill"><span class="dot-red"></span>Arduino: Beklemede</div>
</div>

<div class="asrs-dashboard-grid">
    <section class="panel asrs-3d-panel">
        <div class="panel-header">
            <div class="panel-title"><span class="panel-title-dot"></span>3D Sistem Görünümü</div>
        </div>

        <div id="asrs3DHost" class="asrs-3d-host">
            <div class="asrs-3d-placeholder">
                <div class="asrs-3d-placeholder-title">3D model otomatik yükleniyor</div>
                <div class="asrs-3d-placeholder-sub">
                    Sayfa açıldığında projedeki STEP dosyasını okuyacak viewer otomatik başlatılır.
                </div>
            </div>
            <iframe id="asrs3DFrame" class="asrs-3d-frame" title="ASRS 3D Viewer"></iframe>
        </div>

    </section>

    <section class="panel asrs-right-panel">
        <div class="panel-header">
            <div class="panel-title"><span class="panel-title-dot"></span>Raf Hücreleri (RETRIEVE)</div>
        </div>

        <div class="asrs-rack-wrap">
            <div class="asrs-rack-header">
                <span>Satır / Sütun</span>
                <span>Durum</span>
            </div>

            <div id="asrsRackGrid" class="asrs-rack-grid">
                @for (var row = 1; row <= 3; row++)
                {
                    for (var col = 1; col <= 4; col++)
                    {
                        <button
                            type="button"
                            class="asrs-cell asrs-cell-empty"
                            data-row="@row"
                            data-col="@col"
                            aria-label="Raf @row,@col RETRIEVE">
                            <span class="asrs-cell-pos">@row,@col</span>
                            <span class="asrs-cell-state">Boş</span>
                        </button>
                    }
                }
            </div>
        </div>

        <div class="asrs-actions">
            <button id="refreshRackBtn" class="asrs-btn asrs-btn-secondary" type="button">Raf Durumunu Yenile</button>
            <button id="statusBtn" class="asrs-btn asrs-btn-secondary" type="button">Sistem Durumu</button>
        </div>

    </section>
</div>

<section class="panel asrs-log-panel">
    <div class="panel-header">
        <div class="panel-title"><span class="panel-title-dot"></span>Komut Günlüğü</div>
    </div>
    <div id="asrsLog" class="asrs-log-list"></div>
</section>

@section Scripts {
<script>
(() => {
    const apiBase = '/api/asrs';
    const stepFilePath = '/models/asrs-system.step';
    const stepViewerPath = '/3d/step-viewer/index.html';

    const rackGrid = document.getElementById('asrsRackGrid');
    const logEl = document.getElementById('asrsLog');
    const refreshRackBtn = document.getElementById('refreshRackBtn');
    const statusBtn = document.getElementById('statusBtn');

    const asrs3DFrame = document.getElementById('asrs3DFrame');
    const asrs3DHost = document.getElementById('asrs3DHost');
    const asrs3DPlaceholder = asrs3DHost ? asrs3DHost.querySelector('.asrs-3d-placeholder') : null;

    function log(message, type = 'info') {
        const item = document.createElement('div');
        item.className = `asrs-log-item asrs-log-${type}`;
        const time = new Date().toLocaleTimeString('tr-TR');
        item.textContent = `[${time}] ${message}`;
        logEl.prepend(item);
    }

    async function requestJson(url, options) {
        const res = await fetch(url, options);
        const text = await res.text();
        let data = null;
        if (text) {
            try { data = JSON.parse(text); } catch { data = text; }
        }
        if (!res.ok) {
            const err = typeof data === 'string' ? data : (data?.message || res.statusText);
            throw new Error(err || 'İstek başarısız.');
        }
        return data;
    }

    function setCellState(row, col, occupied) {
        const cell = rackGrid.querySelector(`.asrs-cell[data-row="${row}"][data-col="${col}"]`);
        if (!cell) return;

        cell.classList.remove('asrs-cell-empty', 'asrs-cell-full');
        cell.classList.add(occupied ? 'asrs-cell-full' : 'asrs-cell-empty');

        const stateEl = cell.querySelector('.asrs-cell-state');
        if (stateEl) stateEl.textContent = occupied ? 'Dolu' : 'Boş';
    }

    async function loadRackState() {
        try {
            const data = await requestJson(`${apiBase}/rack-state`);
            if (Array.isArray(data)) {
                data.forEach(x => {
                    const row = Number(x.row) + 1; // API 0-based -> UI 1-based
                    const col = Number(x.col) + 1;
                    setCellState(row, col, !!x.isOccupied);
                });
                log('Raf durumu güncellendi.', 'success');
            }
        } catch (err) {
            log(`Raf durumu alınamadı: ${err.message}`, 'error');
        }
    }

    async function sendRetrieve(uiRow, uiCol) {
        const payload = { row: uiRow - 1, col: uiCol - 1 }; // UI 1-based -> API 0-based
        try {
            const result = await requestJson(`${apiBase}/retrieve`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            log(`RETRIEVE kuyruğa alındı: Hücre ${uiRow},${uiCol} (Komut #${result.commandId})`, 'success');
        } catch (err) {
            log(`RETRIEVE hata (${uiRow},${uiCol}): ${err.message}`, 'error');
        }
    }

    async function loadSystemStatus() {
        try {
            const status = await requestJson(`${apiBase}/system-status`);
            log(`Sistem durumu: ${JSON.stringify(status)}`, 'info');
        } catch (err) {
            log(`Sistem durumu alınamadı: ${err.message}`, 'error');
        }
    }

    rackGrid.addEventListener('click', (e) => {
        const btn = e.target.closest('.asrs-cell');
        if (!btn) return;
        const row = Number(btn.dataset.row);
        const col = Number(btn.dataset.col);
        sendRetrieve(row, col);
    });

    refreshRackBtn.addEventListener('click', loadRackState);
    statusBtn.addEventListener('click', loadSystemStatus);

    function bootStepViewer(filePath = stepFilePath, viewerPath = stepViewerPath) {
        const src = `${viewerPath}?file=${encodeURIComponent(filePath)}`;
        if (asrs3DPlaceholder) asrs3DPlaceholder.hidden = false;
        asrs3DFrame.onload = () => {
            if (asrs3DPlaceholder) asrs3DPlaceholder.hidden = true;
        };
        asrs3DFrame.src = src;
        // Bazı tarayıcı/caching durumlarında onload geç gelebiliyor.
        // Viewer aynı alanda kalsın diye kısa bir süre sonra placeholder'ı kaldır.
        window.setTimeout(() => {
            if (asrs3DPlaceholder) asrs3DPlaceholder.hidden = true;
        }, 1200);
        log(`3D viewer başlatıldı: ${filePath}`, 'success');
    }

    // Dışarıdan özel 3D HTML embed etmek istersen:
    // window.asrsSet3DContent('<model-viewer ...></model-viewer>')
    window.asrsSet3DContent = function (html) {
        const host = document.getElementById('asrs3DHost');
        if (!host || !html) return;
        host.innerHTML = html;
        log('Özel 3D embed yüklendi.', 'success');
    };

    // STEP dosya yolu/viewer yolunu runtime'da değiştirmek istersen:
    // window.asrsSetStepSources('/models/xxx.step', '/3d/step-viewer/index.html')
    window.asrsSetStepSources = function (filePath, viewerPath) {
        if (!filePath || !viewerPath) return;
        bootStepViewer(filePath, viewerPath);
    };

    bootStepViewer();
    loadRackState();
})();
</script>
}
