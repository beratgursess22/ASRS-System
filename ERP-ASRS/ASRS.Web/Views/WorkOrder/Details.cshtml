@model ASRS.Core.DTOs.WorkOrderListDto
@using ASRS.Core.DTOs
@using System.Text.Json
@{
    ViewData["Title"] = "Is Emri Detayi";
    var tree = ViewBag.BomTree as IReadOnlyList<BomRequirementNodeDto> ?? new List<BomRequirementNodeDto>();
    var treeJson = JsonSerializer.Serialize(tree, new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    });
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workorder.css" asp-append-version="true" />
}

<div class="page-header">
    <h1 class="page-title">Is Emri Detayi - @Model.OrderNumber</h1>
    <a asp-action="Index" class="btn-edit">&larr; Is Emirlerine Don</a>
</div>

<div class="card" style="margin-bottom:1rem;">
    <div class="card-header">
        <h2 class="card-title">@Model.ProductCode - @Model.ProductName</h2>
    </div>
    <div class="wo-detail-grid">
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Baslik</div>
            <div class="wo-detail-value">@Model.Title</div>
        </div>
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Miktar</div>
            <div class="wo-detail-value">@Model.Quantity</div>
        </div>
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Durum</div>
            <div class="wo-detail-value">@Model.Status</div>
        </div>
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Plan Baslangic</div>
            <div class="wo-detail-value">@Model.PlannedStartDate.ToString("dd.MM.yyyy")</div>
        </div>
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Plan Bitis</div>
            <div class="wo-detail-value">@Model.PlannedEndDate.ToString("dd.MM.yyyy")</div>
        </div>
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Is Emrini Veren</div>
            <div class="wo-detail-value">@(Model.CreatedByUserName ?? "-")</div>
        </div>
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Olusturulma Zamani</div>
            <div class="wo-detail-value">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">BOM Agaci (Toplam Gereksinim / Mevcut Stok)</h2>
    </div>
    <div class="bom-table-wrap">
        <table class="data-table bom-data-table">
            <thead>
                <tr>
                    <th>Tip</th>
                    <th>Kod</th>
                    <th>Bilesen</th>
                    <th>Toplam Gereken</th>
                    <th>Mevcut Stok</th>
                    <th>Durum</th>
                    <th>Islem</th>
                </tr>
            </thead>
            <tbody id="bomTreeBody"></tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    const bomTree = @Html.Raw(treeJson);

    function escapeHtml(value) {
        if (value === null || value === undefined) return "";
        return String(value)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/\"/g, "&quot;")
            .replace(/'/g, "&#39;");
    }

    function toggleNode(id) {
        const rows = document.querySelectorAll(`[data-parent="${id}"]`);
        if (!rows.length) return;

        const shouldOpen = Array.from(rows).some(r => r.style.display === 'none');

        rows.forEach(row => {
            row.style.display = shouldOpen ? '' : 'none';

            // If collapsing a branch, collapse all descendants too.
            if (!shouldOpen) {
                const childId = row.dataset.node;
                if (!childId) return;
                const descendants = document.querySelectorAll(`[data-ancestor="${childId}"]`);
                descendants.forEach(d => d.style.display = 'none');
            }
        });
    }

    function renderNode(node, level, indexPath, parentId, ancestorPath) {
        const hasChildren = node.children && node.children.length > 0;
        const typeClass = node.componentType === "Product" ? "type-product" : "type-material";
        const statusClass = node.isCycleDetected
            ? "status-cycle"
            : (node.isStockSufficient ? "status-ok" : "status-bad");
        const statusText = node.isCycleDetected
            ? "Cycle"
            : (node.isStockSufficient ? "Yeterli" : "Yetersiz");

        const rowId = `row-${indexPath}`;
        const depthPadding = level * 20;
        const parentAttr = parentId ? `data-parent="${parentId}"` : "";
        const ancestorAttr = ancestorPath ? `data-ancestor="${ancestorPath}"` : "";
        const initialHidden = parentId ? 'style="display:none;"' : '';

        let html = `
            <tr id="${rowId}" data-node="${rowId}" ${parentAttr} ${ancestorAttr} ${initialHidden}>
                <td><span class="bom-pill ${typeClass}">${escapeHtml(node.componentType)}</span></td>
                <td><span class="bom-code">${escapeHtml(node.componentCode)}</span></td>
                <td>
                    <div class="bom-name" style="padding-left:${depthPadding}px;">
                        ${escapeHtml(node.componentName)}
                    </div>
                </td>
                <td><strong>${node.totalRequired}</strong></td>
                <td>${node.stockQuantity}</td>
                <td><span class="bom-status ${statusClass}">${statusText}</span></td>
                <td>
                    ${hasChildren ? `<button type="button" class="btn-edit bom-toggle" onclick="toggleNode('${rowId}')">Alt Ac/Kapat</button>` : '<span class="muted">-</span>'}
                </td>
            </tr>`;

        if (hasChildren) {
            const nextAncestor = ancestorPath ? `${ancestorPath},${rowId}` : rowId;
            html += node.children
                .map((child, idx) => renderNode(child, level + 1, `${indexPath}-${idx}`, rowId, nextAncestor))
                .join("");
        }

        return html;
    }

    const body = document.getElementById("bomTreeBody");

    if (!bomTree || bomTree.length === 0) {
        body.innerHTML = '<tr><td colspan="7" class="muted" style="padding:1rem;">Bu is emri urunu icin tanimli BOM bulunamadi.</td></tr>';
    } else {
        body.innerHTML = bomTree
            .map((node, idx) => renderNode(node, 0, `${idx}`, "", ""))
            .join("");
    }
</script>
}
