@model ASRS.Core.DTOs.PurchaseOrderListDto
@using ASRS.Core.Enums
@using ASRS.Core.DTOs
@{
    ViewData["Title"] = "Siparis Detayi";

    static string StatusText(PurchaseOrderStatus status) => status switch
    {
        PurchaseOrderStatus.Draft => "Taslak",
        PurchaseOrderStatus.Approved => "Onaylandi",
        PurchaseOrderStatus.PartiallyReceived => "Kismi Teslim",
        PurchaseOrderStatus.Received => "Teslim Alindi",
        PurchaseOrderStatus.Cancelled => "Iptal",
        _ => status.ToString()
    };

    static List<PurchaseOrderStatus> AllowedStatuses(PurchaseOrderStatus current) => current switch
    {
        PurchaseOrderStatus.Draft => new List<PurchaseOrderStatus>
        {
            PurchaseOrderStatus.Draft,
            PurchaseOrderStatus.Approved,
            PurchaseOrderStatus.Cancelled
        },
        PurchaseOrderStatus.Approved => new List<PurchaseOrderStatus>
        {
            PurchaseOrderStatus.Approved,
            PurchaseOrderStatus.Cancelled
        },
        PurchaseOrderStatus.PartiallyReceived => new List<PurchaseOrderStatus>
        {
            PurchaseOrderStatus.PartiallyReceived,
            PurchaseOrderStatus.Cancelled
        },
        PurchaseOrderStatus.Received => new List<PurchaseOrderStatus>
        {
            PurchaseOrderStatus.Received
        },
        PurchaseOrderStatus.Cancelled => new List<PurchaseOrderStatus>
        {
            PurchaseOrderStatus.Cancelled
        },
        _ => new List<PurchaseOrderStatus> { current }
    };

    var allowedStatuses = AllowedStatuses(Model.Status);
    var canReceive = Model.Status == PurchaseOrderStatus.Approved || Model.Status == PurchaseOrderStatus.PartiallyReceived;
    var canEditPricing = (User.IsInRole("Yönetici") || User.IsInRole("Satın Alma")) && Model.Status != PurchaseOrderStatus.Cancelled;
    var canEditHeader = Model.Status != PurchaseOrderStatus.Received && Model.Status != PurchaseOrderStatus.Cancelled;
    var canEditSupplier = Model.Status == PurchaseOrderStatus.Draft;
    var suppliers = ViewBag.Suppliers as IEnumerable<SupplierListDto> ?? Enumerable.Empty<SupplierListDto>();
    var totalsByCurrency = Model.Items
        .GroupBy(i => string.IsNullOrWhiteSpace(i.Currency) ? "TRY" : i.Currency!.Trim().ToUpperInvariant())
        .Select(g => new
        {
            Currency = g.Key,
            Total = g.Sum(x => x.LineTotal)
        })
        .OrderBy(x => x.Currency)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workorder.css" asp-append-version="true" />
}

<div class="page-header">
    <h1 class="page-title">Siparis Detayi - @Model.OrderNumber</h1>
    <a asp-action="Index" class="btn-edit">&larr; Siparislere Don</a>
</div>

@if (TempData["Error"] is string errorMessage)
{
    <div class="alert-box alert-error">@errorMessage</div>
}

@if (TempData["Success"] is string successMessage)
{
    <div class="alert-box" style="border:1px solid #166534; color:#166534; background:#dcfce7;">@successMessage</div>
}

<div class="card" style="margin-bottom:1rem;">
    <div class="card-header">
        <h2 class="card-title">Talep #@Model.PurchaseRequestId - @Model.WorkOrderNumber</h2>
    </div>

    <div class="wo-detail-grid">
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Durum</div>
            <div class="wo-detail-value">@StatusText(Model.Status)</div>
        </div>
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Olusturulma</div>
            <div class="wo-detail-value">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
        </div>
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Not</div>
            <div class="wo-detail-value">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</div>
        </div>
        <div class="wo-detail-kpi">
            <div class="wo-detail-label">Genel Toplam</div>
            <div class="wo-detail-value">@Model.TotalAmount.ToString("N2")</div>
        </div>
    </div>

    <form method="post" asp-action="UpdateHeader" style="padding: 0 1rem 1rem 1rem; display:flex; gap:0.5rem; flex-wrap:wrap; align-items:flex-end;">
        <input type="hidden" name="PurchaseOrderId" value="@Model.Id" />

        <div style="display:flex; flex-direction:column; gap:0.35rem; min-width:260px;">
            <label class="wo-detail-label">Tedarikci</label>
            <select name="SupplierId" class="form-input" @((canEditHeader && canEditSupplier) ? null : "disabled")>
                <option value="">Seciniz</option>
                @foreach (var supplier in suppliers)
                {
                    if (Model.SupplierId == supplier.Id)
                    {
                        <option value="@supplier.Id" selected="selected">@supplier.Code - @supplier.Name</option>
                    }
                    else
                    {
                        <option value="@supplier.Id">@supplier.Code - @supplier.Name</option>
                    }
                }
            </select>
            @if (!canEditSupplier)
            {
                <input type="hidden" name="SupplierId" value="@(Model.SupplierId?.ToString() ?? "")" />
            }
        </div>

        <div style="display:flex; flex-direction:column; gap:0.35rem; min-width:220px;">
            <label class="wo-detail-label">Beklenen Teslim</label>
            <input type="date" name="ExpectedDeliveryDate" class="form-input" value="@(Model.ExpectedDeliveryDate?.ToString("yyyy-MM-dd"))" @(canEditHeader ? null : "disabled") />
        </div>

        <div style="display:flex; flex-direction:column; gap:0.35rem; min-width:320px; flex:1;">
            <label class="wo-detail-label">PO Notu</label>
            <input type="text" name="Notes" class="form-input" value="@Model.Notes" placeholder="Not (opsiyonel)" @(canEditHeader ? null : "disabled") />
        </div>

        @if (canEditHeader)
        {
            <button type="submit" class="btn-edit">Baslik Kaydet</button>
        }
        else
        {
            <span class="muted" style="padding:0.55rem 0.25rem;">Bu durumda baslik guncellenemez.</span>
        }
    </form>

    <form method="post" asp-action="UpdateStatus" style="padding: 0 1rem 1rem 1rem; display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
        <input type="hidden" name="id" value="@Model.Id" />
        <select name="newStatus" class="form-input" style="width:220px;">
            @foreach (var status in allowedStatuses)
            {
                if (Model.Status == status)
                {
                    <option value="@((int)status)" selected="selected">@StatusText(status)</option>
                }
                else
                {
                    <option value="@((int)status)">@StatusText(status)</option>
                }
            }
        </select>
        <button type="submit" class="btn-primary">Durum Guncelle</button>
    </form>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Siparis Kalemleri (@Model.Items.Count)</h2>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Tip</th>
                <th>Kod</th>
                <th>Ad</th>
                <th>Siparis Miktari</th>
                <th>Teslim Alinan</th>
                <th>Kalan</th>
                <th>Birim Fiyat</th>
                <th>Para Birimi</th>
                <th>Kalem Toplam</th>
                <th>Islem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                var isProduct = item.ProductId.HasValue;
                <tr>
                    <td>@(isProduct ? "Urun" : "Malzeme")</td>
                    <td>@(isProduct ? item.ProductCode : item.MaterialCode)</td>
                    <td>@(isProduct ? item.ProductName : item.MaterialName)</td>
                    <td>@item.OrderedQuantity</td>
                    <td>@item.ReceivedQuantity</td>
                    <td><strong>@item.RemainingQuantity</strong></td>
                    <td>@item.UnitPrice.ToString("N2")</td>
                    <td>@(string.IsNullOrWhiteSpace(item.Currency) ? "-" : item.Currency)</td>
                    <td><strong>@item.LineTotal.ToString("N2")</strong></td>
                    <td>
                        <div style="display:flex; gap:0.35rem; flex-wrap:wrap; align-items:center;">
                            @if (canEditPricing)
                            {
                                <form method="post" asp-action="UpdateItemPricing" style="display:flex; gap:0.35rem; align-items:center;">
                                    <input type="hidden" name="PurchaseOrderId" value="@Model.Id" />
                                    <input type="hidden" name="PurchaseOrderItemId" value="@item.Id" />
                                    <input type="number" min="0" step="0.01" name="UnitPrice" class="form-input" value="@item.UnitPrice" style="width:110px;" required />
                                    <input type="text" name="Currency" class="form-input" value="@(string.IsNullOrWhiteSpace(item.Currency) ? "TRY" : item.Currency)" maxlength="10" style="width:85px; text-transform:uppercase;" />
                                    <button type="submit" class="btn-edit">Fiyat Kaydet</button>
                                </form>
                            }

                            @if (canReceive && item.RemainingQuantity > 0)
                            {
                                <form method="post" asp-action="ReceiveItem" style="display:flex; gap:0.35rem; align-items:center;">
                                    <input type="hidden" name="PurchaseOrderId" value="@Model.Id" />
                                    <input type="hidden" name="PurchaseOrderItemId" value="@item.Id" />
                                    <input type="number" min="1" max="@item.RemainingQuantity" name="ReceivedQuantity" class="form-input" style="width:90px;" required />
                                    <button type="submit" class="btn-edit">Teslim Al</button>
                                </form>
                            }

                            @if (!canEditPricing && !(canReceive && item.RemainingQuantity > 0))
                            {
                                <span class="muted">-</span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalsByCurrency.Count > 0)
    {
        <div style="padding:1rem; border-top:1px solid rgba(255,255,255,0.06); display:flex; gap:1rem; flex-wrap:wrap;">
            @foreach (var total in totalsByCurrency)
            {
                <div class="wo-detail-kpi" style="min-width:200px; margin:0;">
                    <div class="wo-detail-label">Toplam (@total.Currency)</div>
                    <div class="wo-detail-value">@total.Total.ToString("N2")</div>
                </div>
            }
        </div>
    }
</div>
