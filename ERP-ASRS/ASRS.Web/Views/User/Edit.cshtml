@model ASRS.Core.DTOs.UserListDto

@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}
@* // bu sayfa, kullanıcıların mevcut bilgilerini düzenleyebilecekleri bir form içerir. Kullanıcı adı, e-posta (değiştirilemez), rol ve durum gibi bilgileri güncelleyebilirler. Form gönderildiğinde, ilgili kullanıcı bilgileri güncellenir ve kullanıcı liste sayfasına yönlendirilir. *@

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@if (ViewBag.Error != null)
{
    <div class="alert-box alert-error">@ViewBag.Error</div>
}

<div class="db-section-label">Kullanıcı Düzenle</div>
<div class="panel" style="max-width:600px;">
    <div class="panel-header">
        <div class="panel-title"><span class="panel-title-dot"></span>@Model.FullName</div>
        <a asp-controller="User" asp-action="Index" class="panel-action">← Listeye Dön</a>
    </div>
    <div style="padding:1.25rem;">
        <form asp-controller="User" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group" style="margin-bottom:1rem;">
                <label>Ad Soyad</label>
                <input type="text" name="fullName" class="form-input" value="@Model.FullName" required />
            </div>
            <div class="form-group" style="margin-bottom:1rem;">
                <label>E-posta (değiştirilemez)</label>
                <input type="email" class="form-input" value="@Model.Email" disabled />
            </div>
            <div class="form-group" style="margin-bottom:1rem;">
                <label>Rol</label>
                <select name="role" class="form-input" required>
                    @foreach (var rol in ViewBag.Roles as IEnumerable<string> ?? new List<string>())
                    {
                        if (rol == Model.Role)
                        {
                            <option value="@rol" selected>@rol</option>
                        }
                        else
                        {
                            <option value="@rol">@rol</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group" style="margin-bottom:1.5rem;">
                <label>Durum</label>
                <select name="isActive" class="form-input">
                    @if (Model.IsActive)
                    {
                        <option value="true" selected>Aktif</option>
                        <option value="false">Pasif</option>
                    }
                    else
                    {
                        <option value="true">Aktif</option>
                        <option value="false" selected>Pasif</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-primary">Kaydet</button>
        </form>
    </div>
</div>